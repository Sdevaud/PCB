		(uuid "4e617ac9-17dc-4bec-93ca-9435bfbcb636")
	)
	(text "Mofset TPW1R306PL,L1Q :\nQg = 91 nC\nQgd = 14.4 nC\nRds(on) = 0.95 mR\nRds(on),max = 1.29 mR\nImax (25 deg) = 100 A\nVgs,max = (+-) 20V\nIrms = I*sqrt(D)\nPcond = Irms**2 * Rds(on)\nPcond,max = 9.5 W\nPsw = 0.5*Vbus*Isw(tr+tf)*fpwm"
		(exclude_from_sim no)
		(at 156.21 114.3 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "5528f3f6-32bd-4daf-8486-ccd151c17940")
	)
	(text "RC snuber :\nattenuates the oscillations\ntau = RC = 16.5 ns\nfRC = 1/(2piRC) = 9.65 MHz\nPr = C(Vbus**2)fpwm\nPr,max = 0.230 W "
		(exclude_from_sim no)
		(at 250.19 113.03 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
