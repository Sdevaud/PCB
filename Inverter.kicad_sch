	(text "R : protect overtensions\n+R better protection but slower\n-R faster but less protection\ntmiller = Qgd/Ig\ne.g : G current = 200mA\ntmiller = 33.5 ns\n\nDiodes : \nrapid discharge by short-circuiting the resistor"
		(exclude_from_sim no)
		(at 194.31 115.57 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "4c100f50-5d6b-4a0b-a99b-0dc1cafffe4f")
	)
	(text "2"
		(exclude_from_sim no)
		(at 250.19 102.87 0)
		(effects
			(font
				(size 2.032 2.032)
				(thickness 0.4064)
				(bold yes)
			)
		)
		(uuid "4e617ac9-17dc-4bec-93ca-9435bfbcb636")
	)
	(text "Mofset :\nN = 6\nQg = 41 nC\nQgd = 6.7 nC\nRds(on),max = 2.2 mR\nImax = 100 A\nPcond = I*sqrt(D)\nPcond,max = 9.5 W\nPsw = 0.5*Vbus*(tr+tf)*fpwm"
		(exclude_from_sim no)
		(at 156.21 114.3 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "5528f3f6-32bd-4daf-8486-ccd151c17940")
	)
	(text "RC snuber :\nattenuates the oscillations\ntau = RC = 16.5 ns\nfRC = 1/(2piRC) = 9.65 MHz\nPr = C(Vbus**2)fpwm"
		(exclude_from_sim no)
		(at 250.19 113.03 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "57ad844f-7e3a-459f-ba2d-2d2c2c55bee6")
	)
	(text "protects the MOSFET \nagainst negative voltages"
